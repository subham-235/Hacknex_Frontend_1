# Public API URL only. Never put Gemini, Twilio, MongoDB or Redis secrets here.
# Development proxy forwards /api to http://127.0.0.1:5000.
VITE_API_URL=/api
# Optional Socket.IO origin. Local development automatically uses the current
# hostname on port 5000, so this is normally needed only for custom setups.
# VITE_SOCKET_URL=http://localhost:5000
